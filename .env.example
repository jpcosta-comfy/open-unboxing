# Comfy API key from https://platform.comfy.org/profile/api-keys
# Never commit a real key. The app reads this on the server only.
# Sent as Authorization: Bearer and as extra_data.api_key_comfy_org (partner nodes).
COMFY_API_KEY=your-api-key-here

# Comfy serverless deployment endpoint from `comfy deploy up`.
# Example: https://dep-xxxx.run.comfy.app
# Defaults to https://cloud.comfy.org when unset.
COMFY_BASE_URL=https://cloud.comfy.org
